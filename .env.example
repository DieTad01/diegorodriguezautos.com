# Copia este archivo como .env en el servidor y llena los valores reales.
# El .env NO se sube a GitHub (está en .gitignore).

NODE_ENV=production

# Dirección pública del sitio (canónica para Google, sitemap y redirección de www)
SITIO_URL=https://diegorodriguezautos.com

# Servidor Node (Nginx redirige el dominio a este puerto)
PORT=3000
HOST=127.0.0.1

# MySQL (usuario con permisos mínimos, ver docs/04-instalacion-vps.md)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=agencia_app
DB_PASSWORD=cambia-esta-contraseña
DB_NAME=agencia_autos

# Firma de las sesiones del panel (64 caracteres aleatorios). Genérala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Las cuentas del panel /admin ya NO van aquí: viven en la tabla
# `administradores` (una por persona). Créalas con:  npm run crear-admin
# (Si tu .env trae ADMIN_USER/ADMIN_PASSWORD_HASH de la versión anterior,
#  actualizar.sh pasa esa cuenta a la tabla y desde entonces se ignoran.)
